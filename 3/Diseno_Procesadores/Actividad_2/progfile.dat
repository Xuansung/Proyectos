00000000000000000000000000000000 // PC 0: NOP -> Operación vacía de arranque.
00110010000100000000000000000101 // PC 1: ALU(inm) ADD -> R1 = R0 + 5. Carga un 5 en R1.
00110010001000000000000000000011 // PC 2: ALU(inm) ADD -> R2 = R0 + 3. Carga un 3 en R2.
00100010001100100001000000000000 // PC 3: ALU(reg) ADD -> R3 = R1 + R2. Suma 5 + 3, guarda 8 en R3.
00100011010000010011000000000000 // PC 4: ALU(reg) SUB -> R4 = R3 - R1. Resta 8 - 5, guarda 3 en R4.
00001001000001000000000000001010 // PC 5: STORE (SW)  -> Guarda el valor de R4 (que es 3) en la RAM (Dirección 10).
00001000010100000000000000001010 // PC 6: LOAD (LW)   -> Carga el valor de la RAM (Dirección 10) y lo guarda en R5. (R5 ahora vale 3).
00100011000000100101000000000000 // PC 7: ALU(reg) SUB -> Compara R5 y R2 restándolos (3 - 3). El resultado no se guarda (wa3=0), pero el Flag de Zero (Z) se pone a 1.
00000011000000000000001010000000 // PC 8: BEQ         -> Salto condicional si Z=1. Como son iguales, salta al PC 10.
00000000000000000000000000000000 // PC 9: NOP         -> Esta instrucción se la salta el BEQ. Nunca debería ejecutarse.
00011111000000000000000000000000 // PC 10: HALT       -> Detiene el procesador.