00000000000000000000000000000000 // PC 0: NOP -> Inicio limpio.
00110010000100000000000000000101 // PC 1: ALU(inm) ADD -> R1 = R0 + 5.
00110010001000000000000000001010 // PC 2: ALU(inm) ADD -> R2 = R0 + 10.
00010010000000000000001100000000 // PC 3: CALL -> Llama a subrutina en PC 12. Pila = 4.
00001001001100000000000000000000 // PC 4: STORE -> Guarda R3(15) en Memoria RAM(Dir 0).
00001000010000000000000000000000 // PC 5: LOAD -> Carga de Memoria RAM(Dir 0) hacia R4. R4 = 15.
00100011010101000011000000000000 // PC 6: ALU(reg) SUB -> R5 = R4 - R3 (15 - 15 = 0). Activa Flag Z.
00000011000000000000001010000000 // PC 7: BEQ -> Si Z=1, salta a PC 10. (Como Z=1, saltará).
00000010000000000000001110000000 // PC 8: JMP -> Salto Incondicional a PC 14. (Nunca se ejecuta gracias al BEQ).
00000000000000000000000000000000 // PC 9: NOP -> Instruccion vacia.
00010001011000000000000011111111 // PC 10: LI -> Load Immediate. Carga 255 directo a R6.
00011111000000000000000000000000 // PC 11: HALT -> Detiene el programa con exito.
00100010001100100001000000000000 // PC 12: ALU(reg) ADD -> (INICIO SUBRUTINA) R3 = R1 + R2 (5 + 10 = 15).
00010011000000000000000000000000 // PC 13: RET -> Retorna de la subrutina sacando el PC 4 de la pila.
00011111000000000000000000000000 // PC 14: HALT -> Detiene el programa (caso de fallo).